n_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">select 
from geo_heading_blocks_2000 as gh
join sf1_2000 as sf1 on gh.LOGRECNO = sf1.LOGRECNO
</sql><sql name="SQL 2">SELECT STATE || COUNTY || TRACT || BLOCK FROM geo_heading_blocks_2000

update geo_heading_blocks_2000
set BLOCKIDFP00 = STATE || COUNTY || TRACT || BLOCK

update geo_heading_blocks_2010
set BLOCKIDFP10 = STATE || COUNTY || TRACT || BLOCK

update geo_heading_blocks_2020
set BLOCKIDFP20 = STATE || COUNTY || TRACT || BLOCK

select BLKIDFP00 from census_blocks_los_angeles_2000_centroids_w_nc

select &quot;0&quot; || SUBSTR(GEOID10, 0, 15), GEOID10 from census_blocks_los_angeles_2010_centroids_w_nc
update census_blocks_los_angeles_2010_centroids_w_nc set GEOID10 = &quot;0&quot; || SUBSTR(GEOID10, 0, 15)
select geoid10 from census_blocks_los_angeles_2010_centroids_w_nc

update census_blocks_los_angeles_2020_centroids_w_nc SET GEOID20 = &quot;0&quot; || State || &quot;0&quot; ||  COUNTY || CTCB20 from census_blocks_los_angeles_2020_centroids_w_nc
update census_blocks_los_angeles_2010_centroids_w_nc set GEOID10 = &quot;0&quot; || SUBSTR(GEOID10, 0, 15)
</sql><sql name="SQL 3">select sf.p001001,  from geo_heading_blocks_2000 ghb
join sf1_2000 sf on ghb.LOGRECNO = sf.LOGRECNO</sql><current_tab id="2"/></tab_sql></sqlb_project>
