             SUM(p.P0010004) as P0010004, SUM(p.P0010005) as P0010005, SUM(p.P0010006) as P0010006, SUM(p.P0010007) as P0010007, 
		     SUM(p.P0010008) as P0010008, SUM(p.P0010009) as P0010009, SUM(p.P0010026) as P0010026
FROM census_blocks_westchester_playa_2020 cb
   join geo_heading_blocks gh on cb.CT20 = gh.TRACT AND cb.CB20 = gh.BLOCK
   join p1 p on gh.LOGRECNO = p.LOGRECNO
group by cb.District


/* select  cb.CT20, cb.CB20, cb.District, cb.district_d, sum(p.P0010001) as P0010001, SUM(p.P0010002) as P0010002,
               SUM(p.P0010010) as P0010010, SUM(p.P0010026) as P0010026
FROM census_blocks_westchester_playa_2020 cb
   join geo_heading_blocks gh on cb.CT20 = gh.TRACT AND cb.CB20 = gh.BLOCK
   join p1 p on gh.LOGRECNO = p.LOGRECNO
group by cb.District */

--select * from geo_heading where TRACT = '275604' and BLOCK = '1000'</sql><sql name="SQL 2">select SUMLEV , count(*)
FROM geo_heading
GROUP BY SUMLEV

CREATE TABLE geo_heading_blocks  AS SELECT * FROM geo_heading WHERE SUMLEV='750';</sql><sql name="SQL 3">select BLOCK, TRACT, COUNT(*)
FROM geo_heading
GROUP BY BLOCK, TRACT
HAVING SUMLEV = '750'
ORDER BY COUNT(*) DESC

SELECT * FROM geo_heading WHERE BLOCK = '1000' AND TRACT = '101110'

select count(*) from geo_heading   --7606605

-- drop table geo_heading_blocks;

select count(*) from geo_heading_blocks  -- 4297038
</sql><sql name="SQL 4">select * from geo_heading_2000 where sumlev = '101' limit 10

select count(*) from geo_heading_2000

select count(*) from sf1_2000

-- delete from sf1_2000</sql><current_tab id="3"/></tab_sql></sqlb_project>
